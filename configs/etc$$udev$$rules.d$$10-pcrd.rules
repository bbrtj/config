RUN+="/bin/chgrp video /sys/class/backlight/intel_backlight/brightness"
RUN+="/bin/chmod g+w /sys/class/backlight/intel_backlight/brightness"

RUN+="/bin/chgrp wheel /sys/class/power_supply/BAT1/charge_start_threshold"
RUN+="/bin/chmod g+w /sys/class/power_supply/BAT1/charge_start_threshold"
RUN+="/bin/chgrp wheel /sys/class/power_supply/BAT1/charge_stop_threshold"
RUN+="/bin/chmod g+w /sys/class/power_supply/BAT1/charge_stop_threshold"

RUN+="/bin/chgrp wheel /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
RUN+="/bin/chmod g+w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"

RUN+="/bin/chgrp wheel /sys/power/state"
RUN+="/bin/chmod g+w /sys/power/state"

