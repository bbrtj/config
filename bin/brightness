#!/usr/bin/env perl

use v5.24;
use warnings;
use autodie;
use List::Util qw(min max);

sub slurp {
	local $/;
	open my $fh, '<', shift;
	return readline $fh;
}

sub spew {
	open my $fh, '>', shift;
	print {$fh} shift;
}

my $wanted = shift;
die "^ or v" unless $wanted =~ m{^[v^]$}i;
my $increase = $wanted eq '^';

my $sys_dir = "/sys/class/backlight/intel_backlight";
my $max = slurp "$sys_dir/max_brightness";
my $curr = slurp "$sys_dir/brightness";
my $new_curr;

if ($curr == 0) {
	# can't take log of 0
	$new_curr = $increase ? 1 : 0;
}
else {
	my $log_scale_max = log($max) / log 2;
	my $log_scale_curr = log($curr) / log 2;
	my $new_log_scale_curr = $log_scale_curr + (-1 + $increase * 2) * 0.1 * $log_scale_max;
	$new_curr = max 0, min $max, int(2 ** $new_log_scale_curr);
}

spew "$sys_dir/brightness", $new_curr;

