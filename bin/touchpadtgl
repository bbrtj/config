#!/usr/bin/env perl

use v5.24;
use warnings;
use autodie;

my $command = "synclient";
my $field = "TouchpadOff";
my $enabled = 1;

{
	open my $output, "-|", $command;

	while (my $line = <$output>) {
		chomp $line;
		my ($disabled) = $line =~ /$field\s*=\s*(\d+)/;
		if (defined $disabled) {
			$enabled = !$disabled;
			last;
		}
	}
}

my $value = $enabled ? '1' : '0';
my $new_command = "$command $field=$value";
say "executing '$new_command'";
print `$new_command`;

